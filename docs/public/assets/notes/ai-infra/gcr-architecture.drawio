<mxfile host="app.diagrams.net" type="device"><diagram id="gcr-architecture" name="GPU-CR：谁搬数据，谁处理控制状态？"><mxGraphModel dx="1200" dy="1020" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1020"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GPU-CR：谁搬数据，谁处理控制状态？" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="1160" height="42" /></mxCell><mxCell id="subtitle" value="NVIDIA 信号驱动路径；协调器编排，Worker 内执行资源拆除与重建。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="58" width="1160" height="40" /></mxCell><mxCell id="note" value="前提：业务保持安全点；控制通道、staging 与快照映射不是同一块空间。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="965" width="1160" height="40" /></mxCell><mxCell id="group0" value="进程外：控制编排" style="rounded=1;fillColor=#F0F9FF;strokeColor=#0369A1;dashed=1;verticalAlign=top;fontSize=21;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="130" width="310" height="780" /></mxCell><mxCell id="group1" value="Worker 进程与所用 GPU" style="rounded=1;fillColor=#F0F9FF;strokeColor=#0369A1;dashed=1;verticalAlign=top;fontSize=21;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="405" y="130" width="750" height="780" /></mxCell><mxCell id="C" value="协调器&#10;cr_client /&#10;multi_cr_client" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="220" width="270" height="145" /></mxCell><mxCell id="D" value="驱动 C/R 工具&#10;cuda-checkpoint&#10;管理剩余 CUDA 状态" style="roun