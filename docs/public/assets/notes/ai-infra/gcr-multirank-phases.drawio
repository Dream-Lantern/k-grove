<mxfile host="app.diagrams.net" type="device"><diagram id="gcr-multirank-phases" name="多 Rank：每阶段通知全部，再等待全部"><mxGraphModel dx="1200" dy="1450" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1450"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="多 Rank：每阶段通知全部，再等待全部" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="1160" height="42" /></mxCell><mxCell id="subtitle" value="阶段是源码主干；安全点与失败处置是额外的工程要求。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="58" width="1160" height="40" /></mxCell><mxCell id="note" value="任一 Rank 失败/超时/结果不明：不当作整体成功；源码没有完整事务回滚保证。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1395" width="1160" height="40" /></mxCell><mxCell id="Q" value="先建立共同安全点&#10;停止新提交、排空相关工作；贯穿下列全过程" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="130" width="840" height="125" /></mxCell><mxCell id="T" value="Checkpoint 1 · IPC teardown&#10;各 Worker 拆导入、备份导出/本地 cuMem、处理 P2P" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="310" width="840" height="125" /></mxCell><mxCell id="D" value="Checkpoint 2 · 自有分配 dump&#10;广播所有 Rank → 等待所有 FINISH" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="490" width="840" height="125" /></mxCell><mxCell id="F" value="Checkpoint 3 · 驱动阶段&#10;toggle 或 lock→checkpoint；核对每 Rank 结果" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="670" width="840" height="125" /></mxCell><mxCell id="R" value="Restore 1–2 · 驱动与自有数据&#10;先恢复可调用的 CUDA 状态，再恢复自管数据" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="850" width="840" height="125" /></mxCell><mxCell id="I" value="Restore 3 · IPC 重建&#10;全部 re-export → 元数据交换 → 全部 re-import" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="1030" width="840" height="125" /></mxCell><mxCell id="V" value="验收后才放行业务&#10;映射、集合通信、数据与服务 Ready 分别确认" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="1210" width="840" height="125" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;dashed=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="Q" target="T"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="T" target="D"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="D" target="F"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="F" target="R"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="R" target="I"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;dashed=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="I" target="V"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>