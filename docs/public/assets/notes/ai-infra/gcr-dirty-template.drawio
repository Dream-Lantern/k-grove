<mxfile host="app.diagrams.net" type="device"><diagram id="gcr-dirty-template" name="论文增量机制：计算写到哪里，而非重跑数值计算"><mxGraphModel dx="1200" dy="1220" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1220"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="论文增量机制：计算写到哪里，而非重跑数值计算" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="1160" height="42" /></mxCell><mxCell id="subtitle" value="这是论文机制示意，不代表此公开提交已包含完整模板生成链路。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="58" width="1160" height="40" /></mxCell><mxCell id="note" value="论文还使用权重/KV 的应用知识；增量在保存时合入基线，不代表任意 Kernel 全透明。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1165" width="1160" height="40" /></mxCell><mxCell id="group0" value="离线：构造可支持 Kernel 的 Dirty Template" style="rounded=1;fillColor=#F0F9FF;strokeColor=#0369A1;dashed=1;verticalAlign=top;fontSize=21;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="125" width="1120" height="260" /></mxCell><mxCell id="group1" value="在线：同次 Kernel 启动的两条执行路径" style="rounded=1;fillColor=#F0F9FF;strokeColor=#0369A1;dashed=1;verticalAlign=top;fontSize=21;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="430" width="1120" height="460" /></mxCell><mxCell id="P" value="PTX 写指令与地址依赖&#10;保留写入地址/长度的必要计算" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="200" width="460" height="125" /></mxCell><mxCell id="T" value="CPU 可执行模板&#10;依赖参数及 launch 配置" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="200" width="460" height="125" /></mxCell><mxCell id="L" value="采集启动参数与配置&#10;必要的 GPU 侧索引数据需处理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="500" width="480" height="125" /></mxCell><mxCell id="G" value="GPU 执行原 Kernel&#10;真实计算与实际写入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="705" width="460" height="125" /></mxCell><mxCell id="S" value="CPU 执行模板&#10;生成/合并 dirty ranges" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="705" width="460" height="125" /></mxCell><mxCell id="C" value="一致性边界后保存变化范围&#10;漏记不可接受；无法安全分析时保守回退" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="985" width="720" height="125" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="P" target="T"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="L" target="G"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="600.0" y="665.0" /><mxPoint x="300.0" y="665.0" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="L" target="S"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="600.0" y="665.0" /><mxPoint x="900.0" y="665.0" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;dashed=1;exitX=1.0;exitY=0.496;entryX=1.0;entryY=0.496;" edge="1" parent="1" source="T" target="S"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="262" /><mxPoint x="1180" y="767" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="G" target="C"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="300.0" y="907.5" /><mxPoint x="600.0" y="907.5" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="S" target="C"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="900.0" y="907.5" /><mxPoint x="600.0" y="907.5" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>