<mxfile host="app.diagrams.net" type="device"><diagram id="gcr-vmm-lifecycle" name="VMM：保留地址语义，替换物理分配"><mxGraphModel dx="1200" dy="1220" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1220"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="VMM：保留地址语义，替换物理分配" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="15" width="1160" height="42" /></mxCell><mxCell id="subtitle" value="区分 VA 预留、映射、物理对象引用；不是 cudaFree 后碰运气重分配。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="58" width="1160" height="40" /></mxCell><mxCell id="note" value="真正回收需所有映射和共享引用释放；最终正常 free 才释放 VA 预留。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#0369A1;fontSize=24;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1165" width="1160" height="40" /></mxCell><mxCell id="A" value="正常分配&#10;Reserve → Create → Map → SetAccess" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="130" width="720" height="125" /></mxCell><mxCell id="B" value="Checkpoint：先完成数据保存&#10;GPU → staging → Host 快照" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="330" width="720" height="125" /></mxCell><mxCell id="C" value="解除映射与释放引用&#10;Unmap + Release；不主动 AddressFree" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="530" width="720" height="125" /></mxCell><mxCell id="D" value="驱动 checkpoint / restore&#10;保存并恢复 CUDA 控制状态与地址语义" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="730" width="720" height="125" /></mxCell><mxCell id="E" value="重建数据面&#10;Create 新物理分配 → 原 VA Map → SetAccess → 拷回" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="930" width="720" height="125" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="A" target="B"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="B" target="C"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="C" target="D"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="" style="edgeStyle=segmentEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0369A1;fontColor=#0369A1;fontFamily=Microsoft YaHei;fontSize=17;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="D" target="E"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>