{
  "name": "systems-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "npm run format:check && npm run lint:md && npm run content:check && vitepress build docs && npm run site:check",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "content:check": "node scripts/validate-content.mjs",
    "site:check": "node scripts/check-dist.mjs",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"docs/articles/**/*.md\" \"tests/fixtures/**/*.md\" \"templates/**/*.md\" \"skill-pack/**/*.md\" \"governance/tooling-guide.md\"",
    "format:write": "prettier --no-error-on-unmatched-pattern --write \"docs/articles/**/*.md\" \"tests/fixtures/**/*.md\" \"templates/**/*.md\" \"skill-pack/**/*.md\" \"governance/tooling-guide.md\"",
    "lint:md": "markdownlint-cli2",
    "diagrams:build": "node scripts/render-diagrams.mjs",
    "quality:check": "npm run format:check && npm run lint:md && npm run content:check && npm test"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "gray-matter": "4.0.3",
    "markdown-it": "14.1.0",
    "markdownlint-cli2": "0.23.3",
    "parse5": "7.2.1",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "vitepress": "1.6.4",
    "vue": "3.5.13"
  }
}
